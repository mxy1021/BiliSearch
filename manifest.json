{
  "manifest_version": 3,
  "name": "BiliSearch",
  "version": "1.0.0",
  "description": "选中网页文字，通过右键菜单在 Bilibili 新标签页中搜索。",
  "permissions": ["contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
